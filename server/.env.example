PORT=3000
DB_HOST=easypanel.devlogconsultoria.com.br
DB_PORT=3248
DB_NAME=domino
DB_USER=root
DB_PASS=your_password_here
N8N_BASE_URL=https://n8ndev.devlogconsultoria.com.br/

# Notificação de comprovante recebido via bot do Telegram (ver notificarComprovanteNoTelegram em
# server.js). TELEGRAM_BOT_TOKEN vem do @BotFather ao criar o bot; TELEGRAM_CHAT_ID é obtido
# acessando https://api.telegram.org/bot<TOKEN>/getUpdates depois que o destinatário mandar
# qualquer mensagem para o bot (procure por "chat":{"id": ...} na resposta). Se não configuradas,
# a notificação é pulada silenciosamente.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Chave secreta usada apenas pela rota de emergência /webhook/admin/emergencia/atualizar-senha-db,
# que permite corrigir a senha do banco mesmo se o login do app estiver quebrado por causa dela.
# Gere um valor longo e aleatório e guarde-o à parte (nunca no app/APK). Trocar este valor invalida
# a rota de emergência até ser reconfigurado.
ADMIN_SECRET_KEY=your_long_random_secret_here
